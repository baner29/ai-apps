# =============================================================================
# BigBank - An open source interview taking platform
# BigBank - Interview Platform — Environment Configuration
# Copy this file to `.env` for local authoring, or pass variables via your
# container / serverless platform's environment / secret manager.
# =============================================================================

# --- Runtime Mode & Access ---
# `local`     : Read-write SQLite (`data/interview.db`), Admin Studio unlocked
# `candidate` : Read-only bundle (`bundle/interview.db`) + ephemeral runtime DB;
#               Admin Studio disabled (404) unless ADMIN_PASSWORD is set (read-only)
APP_MODE=local
APP_TITLE=BigBank
ADMIN_PASSWORD=
# Optional global override for candidate interview access code (overrides template code)
ACCESS_CODE=

# --- Database Paths & Seeding ---
DATABASE_PATH=data/interview.db
BUNDLE_PATH=bundle/interview.db
RUNTIME_DB_PATH=/tmp/runtime.db
AUTO_SEED_EXAMPLES=true

# --- Provider-Agnostic AI Evaluator (LiteLLM) ---
# Supported providers: none | openai | anthropic | gemini | vertex_ai | azure | bedrock | ollama | openai_compatible
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional custom endpoint (Ollama, vLLM, LiteLLM proxy, Azure OpenAI)
LLM_BASE_URL=

# --- Report Storage Sinks (comma-separated: local, s3, gcs, azure_blob) ---
STORAGE_SINKS=local
LOCAL_REPORTS_DIR=data/reports

# AWS S3 or S3-compatible (MinIO, Cloudflare R2, DigitalOcean Spaces)
S3_BUCKET=
S3_PREFIX=interviews
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# Google Cloud Storage (uses ADC / service account)
GCS_BUCKET=
GCS_PREFIX=interviews

# Azure Blob Storage (connection string OR account URL + Managed Identity)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=interviews

# Optional expiring clickable download links in notifications
STORAGE_PRESIGNED_URLS=false
STORAGE_PRESIGNED_TTL_SECONDS=604800

# --- Notification / Push Delivery Sinks (comma-separated: smtp, slack, teams, webhook) ---
NOTIFY_SINKS=

# SMTP Email (attaches PDF report directly)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Slack (incoming webhook URL OR bot token + channel ID for direct PDF upload)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Microsoft Teams (Adaptive Card incoming webhook)
TEAMS_WEBHOOK_URL=

# Generic Webhook (JSON payload, optional HMAC-SHA256 signature & base64 PDF)
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_INCLUDE_PDF_BASE64=false

# --- Python Notebook Sandbox Guardrails ---
SANDBOX_MAX_PACKAGE_MB=25
SANDBOX_MAX_DISK_MB=150
SANDBOX_CELL_TIMEOUT_SECONDS=15
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_IDLE_TIMEOUT_MINUTES=15
# Optional OS user for privilege dropping in Linux/Docker containers (e.g. `sandbox`)
SANDBOX_OS_USER=
SANDBOX_BANNED_PACKAGES=torch,torchvision,torchaudio,tensorflow,tensorflow-cpu,tf-nightly,jax,jaxlib,keras,transformers,diffusers,accelerate,vllm,llama-cpp-python,mxnet,paddlepaddle,cupy,triton,onnxruntime,opencv-python,opencv-contrib-python,scipy,catboost,xgboost,lightgbm,pyspark,dask,ray
