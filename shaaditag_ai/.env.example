# Vertex AI (Agent Platform) Configuration for ShaadiTag AI
# Authentication is via Application Default Credentials (the Cloud Run
# service account) - Vertex AI only, no API key and no local fallback.
GOOGLE_GENAI_USE_VERTEXAI=True
OOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=banercorp-web
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
PORT=8080
